{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Agenda",
  "version": "../package.json",
  "identifier": "com.flux.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "My Agenda",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "center": true,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "My Agenda",
    "shortDescription": "Agenda et tâches synchronisés",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMkFGOTkxQzgwQkM4MTgKUldRWXlBdklrZmtxRTFhdjl3L0xTOTNrOC9ibWUrZTRydElHMTRHUHV2aE1QTS92R3kzRWh1QisK",
      "endpoints": [
        "https://github.com/__GITHUB_REPOSITORY__/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
